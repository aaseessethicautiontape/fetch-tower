# Copy to .env.local and fill in from the Firebase service account JSON
# (Firebase console > Project settings > Service accounts > Generate new private key).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and the \n line breaks exactly as they are in the JSON file.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional: a GitHub token (no scopes needed) raises Door 5's limit from 60 to 5000 checks an hour.
GITHUB_TOKEN=
