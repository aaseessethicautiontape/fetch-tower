rules_version = '2';

// The browser never talks to Firestore directly (PRD section 11).
// All reads and writes go through the Vercel functions in /api using the Admin SDK,
// which ignores these rules. Everyone else is blocked.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
